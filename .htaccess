Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block dotfiles (except .well-known)
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # UI build sources are not meant to be served
    RewriteRule ^frontend(/|$) - [F,L]

    # Force HTTPS for the admin panel (API requests are rejected over HTTP by PHP instead of redirected,
    # because browsers do not follow redirects on CORS preflights).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{REQUEST_URI} !/api/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Universal lead endpoint: POST /api/v1/leads
    RewriteRule ^api/v1/leads/?$ api/v1/leads.php [L,QSA]
</IfModule>

<FilesMatch "(^_bootstrap\.php$|^_ui\.php$|^_security(_admin)?\.php$|\.(ini|log|sql|sh|bak|env|dist|lock|md|gz|json)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    <FilesMatch "lead-hub\.js$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag expose_php Off
    php_value post_max_size 1M
</IfModule>
